# Copy this file to .env and fill in your keys. Never commit .env.
#
# DeepInfra: extract_run.py's default model (Qwen3-235B), real time, paid per token.
# Anthropic: explain_run.py (Claude Message Batches), and extract_run.py with --model claude-...
# Every paid call shows an estimate and asks first; --dry-run calls nothing.

DEEPINFRA_API_KEY="your-deepinfra-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"
