# Copy this file to .env and fill in a User-Agent identification string.
#
# Not a secret and not an API key: SEC's EDGAR data API is free with no signup.
# But SEC's fair-access policy (sec.gov/os/webmaster-faq#developers) requires
# every request to identify the requester -- your name/organization plus a
# contact email. Generic or missing User-Agents risk being blocked.
# FRED (Treasury yield) and Yahoo Finance via yfinance (share price) need nothing.

SEC_EDGAR_USER_AGENT="Your Name your_email@example.com"
